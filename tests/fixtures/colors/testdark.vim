" Supports only a dark background, and uses the 256-color palette.
set background=dark
hi clear
let g:colors_name = 'testdark'

hi Normal ctermfg=252 ctermbg=234
hi CursorLine ctermbg=236 cterm=NONE
hi Comment ctermfg=243 cterm=italic
hi Constant ctermfg=168
hi String ctermfg=71
hi Identifier ctermfg=110
hi Statement ctermfg=139
hi PreProc ctermfg=173
hi Type ctermfg=67
hi Special ctermfg=180
hi Underlined ctermfg=111 cterm=underline
hi Error ctermfg=203
hi Todo ctermfg=228 cterm=bold
hi Bold cterm=bold
hi Italic cterm=italic
hi BoldItalic cterm=bold,italic
hi Added ctermfg=71
hi Changed ctermfg=180
hi Removed ctermfg=203
